* text=auto eol=lf
# Preserve fixed upstream files byte-for-byte, including original line endings.
firmware/** -text
software/** -text
*.png binary
*.jpg binary
*.pdf binary
*.DWG binary
*.SLDPRT binary
*.SLDASM binary
*.STEP -text
*.step -text
*.stp -text
*.m -text
# BOM downloads and their SHA-256 checksums must match byte-for-byte after cloning.
hardware/bom/*.csv -text
hardware/bom/*.json -text
hardware/bom/*.xlsx binary
